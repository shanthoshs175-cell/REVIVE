    - {id: assessment_requested, value: 1}
    - {id: hazard_confirmed, value: 1}
    conclusions:
    - {id: assessment_appropriate, value: 1}
    sourceId: ifrc2025
    rationale: "Assess dangers from outside before providing direct help."
  - id: help_supported
    conditions:
